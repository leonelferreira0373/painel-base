{
  "name": "painel-base",
  "version": "0.1.0",
  "private": true,
  "description": "Painel de administração em estilo Cloudflare (Kumo, Next.js 15, Tailwind 4 e ECharts), com autenticação simulada, definições de conta, tema claro e escuro e análise de dados no navegador.",
  "scripts": {
    "dev": "node scripts/copiar-ativos.mjs && next dev -p 3010",
    "build": "next build",
    "start": "npx serve out -l 3010",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "ativos": "node scripts/copiar-ativos.mjs",
    "postinstall": "node scripts/copiar-ativos.mjs",
    "padroes": "node scripts/verificar-padroes.mjs",
    "exemplo-api": "node scripts/servidor-de-exemplo.mjs"
  },
  "dependencies": {
    "@cloudflare/kumo": "^2.16.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/por": "^1.0.0",
    "@tiptap/core": "^3.32.1",
    "@tiptap/extension-highlight": "^3.32.1",
    "@tiptap/extension-table": "^3.32.1",
    "@tiptap/extension-text-align": "^3.32.1",
    "@tiptap/extension-text-style": "^3.32.1",
    "@tiptap/extensions": "^3.32.1",
    "@tiptap/pm": "^3.32.1",
    "@tiptap/react": "^3.32.1",
    "@tiptap/starter-kit": "^3.32.1",
    "ai-chat": "https://codeload.github.com/ferreirakorp/ai-chat/tar.gz/7accc79f2ed829c27b89463b5a20ebb94c81cfc5",
    "echarts": "^6.1.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.8.0",
    "next": "^16.4.3",
    "pdfjs-dist": "^4.10.38",
    "peerjs": "^1.5.5",
    "qr-scanner": "^1.4.2",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tesseract.js": "^5.1.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/topojson-client": "^3.1.5",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.0",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vitest": "^5.0.5"
  },
  "license": "MIT"
}

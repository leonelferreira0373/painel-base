# Copie para .env (o .env nunca vai para o Git). Só é preciso o que usar.

# Etiqueta da imagem do Docker (por omissão «local»).
VERSAO=local

# Endereço público do site: metadados, robots.txt e sitemap.xml (compilação). Em Docker entra como argumento de construção (docker compose build web).
NEXT_PUBLIC_URL_SITE=https://painel.exemplo.com

# Perfil «publico»: token do túnel do Cloudflare que aponta para o contentor «web» (porta 8080).
TUNNEL_TOKEN=

# Perfil «auth»: segredo para assinar as sessões (mínimo 32 caracteres aleatórios; por exemplo `openssl rand -hex 32`) e origens permitidas.
AUTH_SEGREDO=
AUTH_ORIGENS=http://localhost:3010
